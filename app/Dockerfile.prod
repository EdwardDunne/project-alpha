#################
# FRONTEND BUILD #
#################

FROM node:22-alpine as frontend-builder

WORKDIR /app/frontend

COPY ./frontend/package*.json ./
RUN npm ci

COPY ./frontend ./
RUN NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=production npm run build


###########
# BUILDER #
###########

# pull official base image
FROM python:3.12-alpine as builder

# set work directory
WORKDIR /usr/src/app

# set environment variables
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

# install psycopg2 dependencies
RUN apk update \
    && apk add postgresql-dev gcc python3-dev musl-dev

# lint
RUN pip install --upgrade pip
RUN pip install flake8==7.2.0
COPY . .
RUN flake8 --ignore=E501,F401 ./project_alpha

# install dependencies
COPY ./requirements.txt .
RUN pip wheel --no-cache-dir --no-deps --wheel-dir /usr/src/app/wheels -r requirements.txt


#########
# FINAL #
#########

# pull official base image
FROM python:3.12-alpine

# create directory for the app user
RUN mkdir -p /home/app

# create the app user
RUN addgroup -S app && adduser -S app -G app

# create the appropriate directories
ENV HOME=/home/app
ENV APP_HOME=/home/app/web
RUN mkdir $APP_HOME
RUN mkdir $APP_HOME/staticfiles
RUN mkdir $APP_HOME/mediafiles
WORKDIR $APP_HOME

# install dependencies
RUN apk update && apk add libpq su-exec
COPY --from=builder /usr/src/app/wheels /wheels
COPY --from=builder /usr/src/app/requirements.txt .
RUN pip install --no-cache /wheels/*

# copy entrypoint.prod.sh
COPY ./entrypoint.prod.sh .
RUN sed -i 's/\r$//g'  $APP_HOME/entrypoint.prod.sh
RUN chmod +x  $APP_HOME/entrypoint.prod.sh

# copy project
COPY . $APP_HOME

# copy frontend build output
COPY --from=frontend-builder /app/frontend/static $APP_HOME/frontend/static

# chown all the files to the app user
RUN chown -R app:app $APP_HOME

# NOTE: intentionally not switching to USER app here. staticfiles/ and
# mediafiles/ are overmounted by named volumes at runtime, so their on-disk
# ownership can drift from what's baked into the image (e.g. leftover root
# ownership from an older deploy). The container starts as root so
# entrypoint.prod.sh can re-chown those mount points on every boot, then
# drops to the unprivileged app user via su-exec before running gunicorn.

# run entrypoint.prod.sh
ENTRYPOINT ["/home/app/web/entrypoint.prod.sh"]
